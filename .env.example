# CodeForge AI Configuration
# Copy this file to .env and modify as needed.
# Loaded by pydantic-settings (CODEFORGE_* settings) and remote providers.

# --- Remote provider keys (enable openai:/gemini: models) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides:
# CODEFORGE_OPENAI_API_KEY=
# CODEFORGE_GEMINI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Server (env_prefix CODEFORGE_SERVER_) ---
# CODEFORGE_SERVER_HOST=127.0.0.1
# CODEFORGE_SERVER_PORT=8000

# --- API auth (env_prefix CODEFORGE_API_) ---
# CODEFORGE_API_AUTH_REQUIRED=true
# CODEFORGE_API_API_KEY=change-me
# Also accepted: CODEFORGE_API_KEY=change-me

# --- Rate limit / CORS ---
# CODEFORGE_RATE_LIMIT_ENABLED=true
# CODEFORGE_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# CODEFORGE_CORS_ENABLED=false

# --- Model directory ---
# CODEFORGE_MODEL_DIR=models
