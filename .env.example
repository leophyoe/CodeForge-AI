# CodeForge AI Configuration
# Copy this file to .env and modify as needed

# Server
CODEFORGE_HOST=127.0.0.1
CODEFORGE_PORT=8420
CODEFORGE_LOG_LEVEL=INFO

# Model
CODEFORGE_MODEL=auto
CODEFORGE_WORKSPACE=./workspace

# Security
CODEFORGE_API_KEY=
CODEFORGE_JWT_SECRET=
CODEFORGE_CORS_ORIGINS=http://localhost:3000

# Hardware
CODEFORGE_FORCE_CPU=false
CODEFORGE_FORCE_CUDA=false
CODEFORGE_FORCE_ROCM=false
CODEFORGE_FORCE_MPS=false

# Database
CODEFORGE_DB_PATH=./data/codeforge.db

# Indexing
CODEFORGE_INDEX_PATH=./data/index
CODEFORGE_MAX_INDEX_SIZE_MB=500
